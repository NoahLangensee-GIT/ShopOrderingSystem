<Window x:Class="SOSApp.Views.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ihre Rechnung" Height="480" Width="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="RECHNUNG" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#273C75"/>
            <TextBlock Text="{Binding UserEmail, StringFormat='Kunde: {0}'}" FontSize="14" Margin="0,0,0,20" Foreground="#2F3640"/>
            
            <Separator Background="#DCDDE1"/>
            
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,10">
                <ItemsControl ItemsSource="{Binding CartItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Grid.Column="1">
                                    <TextBlock Text="{Binding Quantity, StringFormat='{}{0} x '}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UnitGrossPrice, StringFormat='CHF {0:N2}'}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <Separator Background="#DCDDE1" Margin="0,10"/>
            
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Netto (exkl. MwSt):" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock Text="MwSt (8.1%):" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="Gesamtsumme Brutto:" FontSize="18" FontWeight="Bold" Foreground="#44BD32"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TotalNetPrice, StringFormat='CHF {0:N2}'}" FontSize="14" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TotalVatPrice, StringFormat='CHF {0:N2}'}" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TotalGrossPrice, StringFormat='CHF {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#44BD32" HorizontalAlignment="Right"/>                                 
                </StackPanel>
            </Grid>

            <Button Content="Bestellung abschliessen &amp; Schliessen" 
                    Margin="0,35,0,0" 
                    Padding="12" 
                    Background="#44BD32" 
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Cursor="Hand"
                    Click="CloseButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>