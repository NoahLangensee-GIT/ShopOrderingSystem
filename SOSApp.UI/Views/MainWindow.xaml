<Window x:Class="SOSApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels1="clr-namespace:SOSApp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels1:MainWindowViewModel}"
        WindowStartupLocation="CenterScreen"
        Title="Shop" Height="910" Width="1300">

    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="20">
            <TextBlock Text="Shop"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#2F3640"
                       DockPanel.Dock="Left" />

            <Button Command="{Binding OpenCartCommand}" 
                    Width="180" Height="40" 
                    Background="#273C75" Foreground="White" 
                    FontWeight="Bold" DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <!-- Warenkorb Icon (Segoe MDL2 Assets) -->
                    <TextBlock Text="&#xE7BF;" 
                               FontFamily="Segoe MDL2 Assets" 
                               FontSize="16"
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"/>
        
                    <!-- Dein Button Text -->
                    <TextBlock Text="Warenkorb öffnen" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="16"
                       Foreground="#44BD32"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="30,0,30,0" />
        </DockPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20">
            <ItemsControl ItemsSource="{Binding CategoryGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,40">
                            <TextBlock Text="{Binding CategoryName}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#2F3640"
                                       Margin="0,0,0,15" />

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Products}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="230"
                                                    Height="300"
                                                    Background="White"
                                                    CornerRadius="10"
                                                    Margin="0,0,20,0"
                                                    BorderBrush="#DCDDE1"
                                                    BorderThickness="1">

                                                <Border.Effect>
                                                    <DropShadowEffect Color="#718093"
                                                                      BlurRadius="10"
                                                                      ShadowDepth="2"
                                                                      Opacity="0.2" />
                                                </Border.Effect>

                                                <Grid VerticalAlignment="Stretch"
                                                      HorizontalAlignment="Center"
                                                      Margin="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="90" />
                                                        <RowDefinition Height="45" />
                                                        <RowDefinition Height="25" />
                                                        <RowDefinition Height="45" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Text="{Binding Name}"
                                                               FontSize="20"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,0,15" />

                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Price, StringFormat='CHF {0:N2}'}"
                                                               FontSize="22"
                                                               Foreground="#44BD32"
                                                               FontWeight="Bold"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,0,15" />

                                                    <TextBlock Grid.Row="2"
                                                               Text="Menge:"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8" />

                                                    <StackPanel Grid.Row="3"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,0,15">

                                                        <Button Content="-"
                                                                Width="28"
                                                                Height="28"
                                                                Command="{Binding DataContext.DecreaseProductQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />

                                                        <TextBlock Text="{Binding Quantity}"
                                                                   Width="40"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="16"
                                                                   FontWeight="Bold" />

                                                        <Button Content="+"
                                                                Width="28"
                                                                Height="28"
                                                                Command="{Binding DataContext.IncreaseProductQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>

                                                    <Button Grid.Row="4"
                                                            Content="{Binding CartButtonText}"
                                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Width="180"
                                                            Height="36"
                                                            Background="{Binding CartButtonBackground}"
                                                            Foreground="White"
                                                            FontWeight="Bold" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Popup x:Name="CartPopup"
               Grid.Row="1"
               IsOpen="{Binding IsCartOpen}"
               Placement="Center"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="600"
                    Background="White"
                    CornerRadius="12"
                    Padding="25"
                    BorderBrush="#DCDDE1"
                    BorderThickness="1">

                <Border.Effect>
                    <DropShadowEffect Color="#2F3640"
                                      BlurRadius="20"
                                      ShadowDepth="4"
                                      Opacity="0.35" />
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                   Text="Warenkorb"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#2F3640"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="X"
                                Command="{Binding CloseCartCommand}"
                                Width="35"
                                Height="35"
                                FontWeight="Bold"
                                HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DCDDE1"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="85" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="16"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                            <Button Content="-"
                                                    Width="28"
                                                    Height="28"
                                                    Command="{Binding DataContext.DecreaseCartItemQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                            <TextBlock Text="{Binding Quantity}"
                                                       Width="40"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="Bold" />

                                            <Button Content="+"
                                                    Width="28"
                                                    Height="28"
                                                    Command="{Binding DataContext.IncreaseCartItemQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TotalGrossPrice, StringFormat='CHF {0:N2}'}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#44BD32"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />

                                        <Button Grid.Column="3"
                                                Content="Löschen"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,20,0,20" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Netto:"
                                   FontSize="16" />

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding TotalNetPrice, StringFormat='CHF {0:N2}'}"
                                   FontSize="16"
                                   FontWeight="Bold" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="MwSt. 8.1%:"
                                   FontSize="16"
                                   Margin="0,8,0,0" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding TotalVatPrice, StringFormat='CHF {0:N2}'}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Brutto:"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,12,0,0" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding TotalGrossPrice, StringFormat='CHF {0:N2}'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#44BD32"
                                   Margin="0,12,0,0" />
                    </Grid>

                    <TextBlock Text="E-Mail für Rechnung:" 
                                FontSize="14" 
                                Margin="0,15,0,5" />
                    <TextBox Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}" 
                                Height="30" 
                                VerticalContentAlignment="Center"
                                Margin="0,0,0,10"/>

                    <Button Content="Bestellen"
                            Command="{Binding PlaceOrderCommand}"
                            Height="42"
                            Margin="0,25,0,0"
                            Background="#273C75"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>