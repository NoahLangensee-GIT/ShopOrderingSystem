<Window x:Class="TODOApp.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TODOApp.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="910" Width="1300">
    <Grid>
<Grid.ColumnDefinitions>
    <ColumnDefinition Width="400"></ColumnDefinition>
    <ColumnDefinition Width="Auto"></ColumnDefinition>
</Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
        </Grid.RowDefinitions>
        <Menu Grid.Column="0" Grid.RowSpan="3"></Menu>
        <TabControl Grid.Column="0" Grid.ColumnSpan="2" TabStripPlacement="Left" Width="1300" Grid.RowSpan="3" Grid.Row="0">
            <TabItem Header="Completed..." Width="300" Padding="10" Height="50" BorderBrush="#1397c7">
                 <StackPanel>
                    <TextBlock Text="Completed Tasks" Height="80" Padding="22" FontWeight="300" FontSize="25" TextAlignment="Left" Background="DarkSeaGreen"  VerticalAlignment="Top"></TextBlock>
                    <ScrollViewer Height="700" VerticalScrollBarVisibility="Auto">
            <ItemsControl  ItemsSource="{Binding CompletedTasks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical">
                                </VirtualizingStackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Background="LightGreen" Margin="0 10" Height="70" Width="900">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="60">
                                    <TextBlock FontWeight="300" FontSize="20" Text="{Binding Title}" Margin="40 0 0 0" Width="400" VerticalAlignment="Center"></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"   Margin="0 0 0 0">
                                    <TextBlock FontWeight="300" Text="{Binding DeadlineText}" FontSize="20" TextWrapping="Wrap" TextAlignment="Right" Width="250" Margin="0 0 10 0" VerticalAlignment="Center"></TextBlock>
                                    <ToolBarTray Background="White" Height="30"  VerticalAlignment="Center"> 
                                        <ToolBar Width="50" Height="30">  
                                            <Button Background="Transparent" Command="{Binding DeleteCommand}" Content="Delete" />  
                                            <Button Background="Transparent" Command="{Binding ModifyOrReadDescription}" Content="Modify/Read Description"/>  
                                        </ToolBar>  
                                    </ToolBarTray>  
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
             </ItemsControl>
        </ScrollViewer>
                     </StackPanel>
            </TabItem>
            <TabItem Header="Tasks..." Width="300" Padding="10" Height="50" BorderThickness="0" BorderBrush="#1397c7">
                <StackPanel>
                    <TextBlock Text="Tasks" Height="80" Padding="22" FontWeight="300" FontSize="25" TextAlignment="Left" Background="MediumPurple"  VerticalAlignment="Top"></TextBlock>
                    <ScrollViewer Height="700" VerticalScrollBarVisibility="Auto">
            <ItemsControl  ItemsSource="{Binding UncompletedTasks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical">
                                </VirtualizingStackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Background="{Binding StatusColor}" Margin="0 10" Height="70" Width="900">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="60">
                                    <CheckBox Margin="30 0 10 0" Width="15" Command="{Binding OnCheckedTaskChangedCommand}" IsChecked="{Binding IsCompleted}" Height="15"/>
                                    <TextBlock FontWeight="300" FontSize="20" Text="{Binding Title}" Margin="0 0 0 0" Width="400" VerticalAlignment="Center"></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"   Margin="0 0 0 0">
                                    <TextBlock FontWeight="300" Text="{Binding DeadlineText}" FontSize="20" TextWrapping="Wrap" TextAlignment="Right" Width="250" Margin="0 0 10 0" VerticalAlignment="Center"></TextBlock>
                                    <ToolBarTray Background="White" Height="30"  VerticalAlignment="Center"> 
                                        <ToolBar  Width="50" Height="30">  
                                            <Button Background="Transparent" Command="{Binding DeleteCommand}" Content="Delete" />  
                                            <Button Background="Transparent" Command="{Binding ModifyNameCommand}" Content="Modify Name" />  
                                            <Button Background="Transparent" Command="{Binding ModifyDateCommand}" Content="Modify Date" />  
                                            <Button Background="Transparent" Command="{Binding ModifyOrReadDescription}" Content="Modify/Read Description"/>  
                                        </ToolBar>  
                                    </ToolBarTray>  
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
             </ItemsControl>
        </ScrollViewer>
        <WrapPanel Height="90" VerticalAlignment="Bottom" Background="CornflowerBlue">
            <Button Width="150"  Height="50" Margin="15 20 0 0" Background="#e9f5f9" Content="+ Task Hinzufügen" Command="{Binding AddTaskCommand}" VerticalAlignment="Center"></Button>
        </WrapPanel>
        </StackPanel>
            </TabItem>
        </TabControl> 
        <Popup Grid.Row="0" Grid.Column="0" Width="300" Height="540" IsOpen="{Binding CreateTaskOpen}" Placement="Right">
            <StackPanel Background="LightGray" Width="290" Height="530">
                <TextBlock Margin="0 20 0 5" TextAlignment="Center" FontSize="12" FontWeight="300" Text="Title"></TextBlock>
                <TextBox  Width="200" Height="26" TextAlignment="Center" Text="{Binding CreateTitleInput}" FontSize="18" FontWeight="300"></TextBox>
                <TextBlock Margin="0 20 0 5" TextAlignment="Center" FontSize="18" FontWeight="300" Text="Date"></TextBlock>
                <DatePicker  Width="200" SelectedDate="{Binding CreateDateInput}"></DatePicker>
                <TextBlock Margin="0 20 0 5" TextAlignment="Center" FontSize="18" FontWeight="300" Text="Description (Optional)"></TextBlock>
                <TextBox  Width="200" Height="220" Text="{Binding CreateDescriptionInput}" TextWrapping="Wrap"></TextBox>
                <Button Content="Create Task" Width="200" Height="40" Margin=" 0 15 0 0" Command="{Binding CreateTaskCommand}"></Button>
                <Button Content="Cancel" Width="200" Height="40" Margin=" 0 15 0 0" Command="{Binding CloseTaskCommand}"></Button>
            </StackPanel>
        </Popup>
    <Popup Grid.Row="0" Grid.Column="0" IsOpen="{Binding ModifyTitleOpen}" Placement="Center" Width="210" Height="150">
        <StackPanel Background="White" Width="200" Height="140" Orientation="Vertical">
            <TextBlock Margin="0 5 0 15" TextAlignment="Center" FontSize="16" FontWeight="300" Text="Change Title"></TextBlock>
            <TextBox Width="190" Height="26" TextAlignment="Center" FontSize="18" FontWeight="300" Text="{Binding ChangeTitleText}"></TextBox>
            <Button Content="Confirm Title" Width="190" Height="30" Command="{Binding ConfirmNameModification}" VerticalAlignment="Bottom" Margin="0 20 0 0"></Button>
        </StackPanel>
    </Popup>
    <Popup Grid.Row="0" Grid.Column="0" IsOpen="{Binding ModifyDeadLineOpen}"  Placement="Center" Width="210" Height="150">
        <StackPanel Background="White" Width="200" Height="140" Orientation="Vertical">
            <TextBlock Margin="0 5 0 15" TextAlignment="Center" FontSize="16" FontWeight="300" Text="Change Deadline"></TextBlock>
            <DatePicker VerticalContentAlignment="Center" SelectedDate="{Binding SelectedDate}" Width="190" Height="40" FontSize="18" FontWeight="300"></DatePicker>
            <Button Content="Confirm Title" Width="190" Height="30" Command="{Binding ConfirmDateModification}" VerticalAlignment="Bottom" Margin="0 20 0 0"></Button>
        </StackPanel>
    </Popup>
    <Popup Grid.Row="0" Grid.Column="0" IsOpen="{Binding ModifyDescriptionOpen}" Placement="Center" Width="220" Height="330">
        <StackPanel Background="Gray" Width="210" Height="320" Orientation="Vertical">
            <TextBlock Margin="0 5 0 15" TextAlignment="Center" FontSize="16" FontWeight="300" Text="Read/Change Description"></TextBlock>
            <TextBox Width="200" Height="220" Text="{Binding DescriptionText}" TextWrapping="Wrap"></TextBox>
            <Button Content="Confirm Description" Width="190" Height="30" Command="{Binding ConfirmDescriptionModification}" VerticalAlignment="Bottom" Margin="0 20 0 0"></Button>
        </StackPanel>
    </Popup>
    </Grid>
</Window>
